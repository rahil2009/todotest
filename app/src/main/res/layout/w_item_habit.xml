<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wi_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/wi_emoji"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_soft"
        android:gravity="center"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wi_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wi_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/wi_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/w_chip"
            android:progressTint="@color/w_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/wi_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_add"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/w_on_accent"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
