<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wi_prio"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Priority" />

        <TextView
            android:id="@+id/wi_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEXT UP"
            android:textColor="@color/w_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/wi_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wi_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wi_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:textColor="@color/w_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wi_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wi_later"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+1 hour"
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wi_done"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_accent_pill"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="✓ Done"
            android:textColor="@color/w_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
